# Maintainer: actuallyaridan <https://github.com/actuallyaridan>
pkgname=aero7-device-manager
pkgver=2.0
pkgrel=1
_srcname=linux-devmgmt
pkgdesc="Aero7 hardware device manager for Linux"
arch=('x86_64' 'aarch64')
url="https://github.com/actuallyaridan/linux-devmgmt"
license=('MIT')
depends=('qt6-base')
makedepends=('cmake' 'ninja')
provides=('linux-devmgmt')
conflicts=('linux-devmgmt')
replaces=('linux-devmgmt')
source=("$pkgname-$pkgver.tar.gz::https://github.com/actuallyaridan/linux-devmgmt/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('77c6517769a100de2f9fa54f005379a2cf5db966135507e29e6b77edb569e0a6')

build() {
    cmake -S "$_srcname-$pkgver" -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "$_srcname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
